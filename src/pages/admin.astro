---
// src/pages/admin.astro - Central Database Admin Panel for Cloudflare D1
import Layout from '../layouts/Layout.astro';
---

<Layout title="Central Database Admin" description="Manage Cloudflare D1 central database for foods and city-wise meals.">
  <div class="max-w-[1200px] w-full mx-auto py-8 space-y-8">

    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-hairline pb-6 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas border border-hairline font-mono text-[10px] text-body uppercase tracking-wider mb-3 shadow-vercel-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse"></span>
          Cloudflare D1 Live Connected
        </div>
        <h1 class="font-sans text-3xl font-semibold tracking-tight text-ink">
          Database Management Console
        </h1>
        <p class="text-mute text-sm mt-1 font-sans">
          Update central food items and city-wise meal databases in real-time across Web & Mobile App.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button id="lock-session-btn" class="hidden px-4 py-2 rounded-lg bg-canvas border border-hairline text-ink font-mono text-xs hover:bg-canvas-soft-2 transition-all">
          🔒 Lock Session
        </button>
        <a href="/health" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-medium text-xs hover:opacity-90 transition-all shadow-vercel-sm">
          ← Return to Calculator
        </a>
      </div>
    </div>

    <!-- Auth Locked State -->
    <div id="auth-modal" class="max-w-md mx-auto my-12 p-8 rounded-xl bg-canvas border border-hairline shadow-vercel-md space-y-6 text-center">
      <div class="w-12 h-12 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center font-mono text-xl">
        🔑
      </div>
      <div>
        <h2 class="font-sans text-xl font-semibold text-ink">Admin Authentication</h2>
        <p class="text-mute text-xs mt-1">Enter your Cloudflare Secrets password to manage D1 tables.</p>
      </div>

      <form id="auth-form" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-mono text-mute uppercase tracking-wider mb-1.5">Secret Key / Password</label>
          <input type="password" id="admin-pass-input" placeholder="••••••••••••" required class="w-full px-3.5 py-2.5 bg-canvas-soft border border-hairline rounded-lg text-sm text-ink outline-none focus:border-link transition-colors font-mono">
        </div>
        <div id="auth-error" class="text-xs text-error hidden font-mono">⚠️ Invalid password or unauthorized access.</div>
        <button type="submit" class="w-full py-2.5 rounded-lg bg-primary text-on-primary font-medium text-sm hover:opacity-90 shadow-vercel-sm transition-all">
          Unlock Console
        </button>
      </form>
    </div>

    <!-- Unlocked Main Admin Interface -->
    <div id="admin-app" class="hidden space-y-6">

      <!-- Navigation Tabs -->
      <div class="flex border-b border-hairline gap-2 font-mono text-xs">
        <button id="tab-foods-btn" class="px-4 py-2.5 border-b-2 border-primary text-primary font-semibold transition-all flex items-center gap-2">
          <span>🍎 Food Directory</span>
          <span id="count-foods" class="px-2 py-0.5 rounded-full bg-primary/10 text-[10px]">0</span>
        </button>
        <button id="tab-meals-btn" class="px-4 py-2.5 border-b-2 border-transparent text-mute hover:text-ink transition-all flex items-center gap-2">
          <span>🥗 City Meals Options</span>
          <span id="count-meals" class="px-2 py-0.5 rounded-full bg-hairline text-[10px]">0</span>
        </button>
      </div>

      <!-- FOODS TAB PANEL -->
      <section id="tab-foods" class="space-y-4">
        <!-- Controls Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-canvas border border-hairline p-4 rounded-xl shadow-vercel-sm">
          <div class="flex flex-wrap items-center gap-2 flex-1">
            <div class="relative flex-1 min-w-[200px]">
              <input type="text" id="food-search-input" placeholder="Search foods by name..." class="w-full pl-8 pr-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink outline-none focus:border-link font-sans">
              <span class="absolute left-2.5 top-2.5 text-mute text-xs">🔍</span>
            </div>
            <select id="food-country-filter" class="px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink outline-none focus:border-link font-mono">
              <option value="">All Countries</option>
              <option value="IN">IN (India)</option>
              <option value="US">US (United States)</option>
              <option value="UK">UK (United Kingdom)</option>
              <option value="AE">AE (UAE)</option>
            </select>
          </div>
          <button id="add-food-btn" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-medium text-xs hover:opacity-90 transition-all flex items-center justify-center gap-1.5 shadow-vercel-sm">
            <span>+ Add Food Item</span>
          </button>
        </div>

        <!-- Foods Table -->
        <div class="border border-hairline rounded-xl bg-canvas overflow-hidden shadow-vercel-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-canvas-soft font-mono uppercase text-[10px] text-mute border-b border-hairline tracking-wider">
                <tr>
                  <th class="p-3">ID</th>
                  <th class="p-3">Item Name</th>
                  <th class="p-3">Cal</th>
                  <th class="p-3">Prot (g)</th>
                  <th class="p-3">Carb (g)</th>
                  <th class="p-3">Fat (g)</th>
                  <th class="p-3">Unit</th>
                  <th class="p-3">Country</th>
                  <th class="p-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="foods-tbody" class="divide-y divide-hairline font-mono">
                <tr><td colspan="9" class="p-6 text-center text-mute font-mono">Loading food data from Cloudflare D1...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- MEALS TAB PANEL -->
      <section id="tab-meals" class="hidden space-y-4">
        <!-- Filter Controls Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-canvas border border-hairline p-4 rounded-xl shadow-vercel-sm">
          <div class="flex flex-wrap items-center gap-2">
            <select id="meal-country-filter" class="px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink outline-none focus:border-link font-mono">
              <option value="IN">IN (India)</option>
              <option value="US">US</option>
              <option value="UK">UK</option>
              <option value="AE">AE</option>
            </select>
            <select id="meal-city-filter" class="px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink outline-none focus:border-link font-mono">
              <option value="">All Cities</option>
              <option value="kolkata">Kolkata</option>
              <option value="mumbai">Mumbai</option>
              <option value="bangalore">Bangalore</option>
              <option value="delhi">Delhi</option>
              <option value="chennai">Chennai</option>
            </select>
            <select id="meal-diet-filter" class="px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink outline-none focus:border-link font-mono">
              <option value="">All Diets</option>
              <option value="veg">Vegetarian</option>
              <option value="non-veg">Non-Veg</option>
            </select>
          </div>
          <button id="add-meal-btn" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-medium text-xs hover:opacity-90 transition-all flex items-center gap-1.5 shadow-vercel-sm">
            <span>+ Add Meal Option</span>
          </button>
        </div>

        <div id="meals-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full p-6 text-center text-mute font-mono">Loading meals from D1...</div>
        </div>
      </section>

    </div>

    <!-- Toast Notification Container -->
    <div id="toast" class="fixed bottom-6 right-6 hidden bg-primary text-on-primary px-4 py-2.5 rounded-lg shadow-vercel-md text-xs font-mono font-medium transition-all z-50"></div>

  </div>

  <!-- Add/Edit Food Modal -->
  <div id="food-form-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-canvas border border-hairline p-6 rounded-xl max-w-lg w-full shadow-vercel-md space-y-4">
      <div class="flex justify-between items-center border-b border-hairline pb-3">
        <h3 id="food-modal-title" class="font-sans font-semibold text-base text-ink">Add New Food Item</h3>
        <button class="close-modal-btn text-mute hover:text-ink text-sm font-mono">✕</button>
      </div>

      <form id="food-form" class="space-y-3 text-xs font-sans">
        <input type="hidden" id="food-id">
        <div>
          <label class="block text-mute font-mono text-[11px] mb-1">Food Name *</label>
          <input type="text" id="food-name" required placeholder="e.g. Masala Dosa" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Calories (kcal) *</label>
            <input type="number" step="0.1" id="food-cal" required placeholder="150" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Protein (g) *</label>
            <input type="number" step="0.1" id="food-prot" required placeholder="4.5" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Carbs (g) *</label>
            <input type="number" step="0.1" id="food-carb" required placeholder="25" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Fat (g) *</label>
            <input type="number" step="0.1" id="food-fat" required placeholder="3.5" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Serving Unit</label>
            <input type="text" id="food-unit" placeholder="g / ml / pc / plate" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link">
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Country</label>
            <input type="text" id="food-country" value="IN" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link uppercase font-mono">
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t border-hairline pt-3 mt-4">
          <button type="button" class="close-modal-btn px-4 py-2 rounded-lg bg-canvas-soft border border-hairline text-ink font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-medium shadow-vercel-sm hover:opacity-90">Save to Cloudflare D1</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Meal Modal -->
  <div id="meal-form-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-canvas border border-hairline p-6 rounded-xl max-w-lg w-full shadow-vercel-md space-y-4">
      <div class="flex justify-between items-center border-b border-hairline pb-3">
        <h3 id="meal-modal-title" class="font-sans font-semibold text-base text-ink">Add New City Meal Option</h3>
        <button class="close-modal-btn text-mute hover:text-ink text-sm font-mono">✕</button>
      </div>

      <form id="meal-form" class="space-y-3 text-xs font-sans">
        <input type="hidden" id="meal-id">
        <div>
          <label class="block text-mute font-mono text-[11px] mb-1">Meal Option Title *</label>
          <input type="text" id="meal-name" required placeholder="e.g. Kolkata Fish Curry & Rice" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Meal Slot *</label>
            <select id="meal-slot" required class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
              <option value="breakfast">Breakfast</option>
              <option value="snack1">Morning Snack</option>
              <option value="lunch">Lunch</option>
              <option value="snack2">Evening Snack</option>
              <option value="dinner">Dinner</option>
              <option value="bedtime">Bedtime Snack</option>
            </select>
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Default Time</label>
            <input type="text" id="meal-time" placeholder="08:30 AM" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Diet Type *</label>
            <select id="meal-diet" required class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link">
              <option value="veg">Vegetarian</option>
              <option value="non-veg">Non-Veg</option>
            </select>
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">Goal Profile</label>
            <select id="meal-profile" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link">
              <option value="balanced">Balanced</option>
              <option value="high-protein">High Protein</option>
              <option value="surplus">Surplus</option>
            </select>
          </div>
          <div>
            <label class="block text-mute font-mono text-[11px] mb-1">City Tags</label>
            <input type="text" id="meal-city" placeholder="kolkata,mumbai,all" class="w-full px-3 py-2 bg-canvas-soft border border-hairline rounded-lg text-ink outline-none focus:border-link font-mono">
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t border-hairline pt-3 mt-4">
          <button type="button" class="close-modal-btn px-4 py-2 rounded-lg bg-canvas-soft border border-hairline text-ink font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-medium shadow-vercel-sm hover:opacity-90">Save Meal to D1</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    let adminToken = '';
    let allFoods = [];
    let allMeals = [];

    const authModal = document.getElementById('auth-modal');
    const authForm = document.getElementById('auth-form');
    const adminPassInput = document.getElementById('admin-pass-input');
    const authError = document.getElementById('auth-error');
    const adminApp = document.getElementById('admin-app');
    const lockBtn = document.getElementById('lock-session-btn');
    const toast = document.getElementById('toast');

    const tabFoodsBtn = document.getElementById('tab-foods-btn');
    const tabMealsBtn = document.getElementById('tab-meals-btn');
    const tabFoods = document.getElementById('tab-foods');
    const tabMeals = document.getElementById('tab-meals');

    // Restore session
    const savedToken = sessionStorage.getItem('whealth_admin_token');
    if (savedToken) {
      adminToken = savedToken;
      initDashboard();
    }

    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = adminPassInput.value.trim();
      if (!pass) return;

      try {
        const res = await fetch('/api/admin?type=foods', {
          headers: { 'Authorization': `Bearer ${pass}` }
        });
        if (res.status === 401) {
          authError.classList.remove('hidden');
          return;
        }
        adminToken = pass;
        sessionStorage.setItem('whealth_admin_token', pass);
        authModal.classList.add('hidden');
        initDashboard();
      } catch (err) {
        authError.textContent = '⚠️ Connection error: ' + err.message;
        authError.classList.remove('hidden');
      }
    });

    if (lockBtn) {
      lockBtn.addEventListener('click', () => {
        sessionStorage.removeItem('whealth_admin_token');
        window.location.reload();
      });
    }

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    function initDashboard() {
      authModal.classList.add('hidden');
      adminApp.classList.remove('hidden');
      if (lockBtn) lockBtn.classList.remove('hidden');
      loadFoods();
      loadMeals();
    }

    // Tab switching
    tabFoodsBtn.addEventListener('click', () => {
      tabFoodsBtn.className = 'px-4 py-2.5 border-b-2 border-primary text-primary font-semibold transition-all flex items-center gap-2';
      tabMealsBtn.className = 'px-4 py-2.5 border-b-2 border-transparent text-mute hover:text-ink transition-all flex items-center gap-2';
      tabFoods.classList.remove('hidden');
      tabMeals.classList.add('hidden');
    });

    tabMealsBtn.addEventListener('click', () => {
      tabMealsBtn.className = 'px-4 py-2.5 border-b-2 border-primary text-primary font-semibold transition-all flex items-center gap-2';
      tabFoodsBtn.className = 'px-4 py-2.5 border-b-2 border-transparent text-mute hover:text-ink transition-all flex items-center gap-2';
      tabMeals.classList.remove('hidden');
      tabFoods.classList.add('hidden');
    });

    // Foods Manager
    async function loadFoods() {
      try {
        const res = await fetch('/api/admin?type=foods', {
          headers: { 'Authorization': `Bearer ${adminToken}` }
        });
        const json = await res.json();
        if (json.success) {
          allFoods = json.data;
          document.getElementById('count-foods').textContent = allFoods.length;
          renderFoods(allFoods);
        }
      } catch (e) {
        console.error('Failed to load foods:', e);
      }
    }

    function renderFoods(foods) {
      const tbody = document.getElementById('foods-tbody');
      tbody.innerHTML = '';
      if (!foods.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="p-6 text-center text-mute font-mono">No food items found.</td></tr>';
        return;
      }
      foods.forEach(f => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-canvas-soft/70 transition-colors font-mono';
        tr.innerHTML = `
          <td class="p-3 text-mute text-[11px]">${f.id}</td>
          <td class="p-3 font-sans font-semibold text-ink">${f.name}</td>
          <td class="p-3 text-primary font-bold">${f.cal}</td>
          <td class="p-3 text-body">${f.prot}</td>
          <td class="p-3 text-body">${f.carb}</td>
          <td class="p-3 text-body">${f.fat}</td>
          <td class="p-3 text-mute">${f.unit || 'g'}</td>
          <td class="p-3"><span class="px-1.5 py-0.5 bg-hairline rounded text-[10px] text-ink font-semibold">${f.country || 'IN'}</span></td>
          <td class="p-3 text-right">
            <button onclick="editFood(${f.id})" class="px-2 py-1 bg-link/10 text-link hover:bg-link/20 rounded transition-colors text-[10px] mr-1">Edit</button>
            <button onclick="deleteFood(${f.id})" class="px-2 py-1 bg-error/10 text-error hover:bg-error/20 rounded transition-colors text-[10px]">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    document.getElementById('food-search-input').addEventListener('input', filterFoods);
    document.getElementById('food-country-filter').addEventListener('change', filterFoods);

    function filterFoods() {
      const query = document.getElementById('food-search-input').value.toLowerCase();
      const country = document.getElementById('food-country-filter').value;
      const filtered = allFoods.filter(f => {
        const matchName = f.name.toLowerCase().includes(query);
        const matchCountry = !country || (f.country || 'IN') === country;
        return matchName && matchCountry;
      });
      renderFoods(filtered);
    }

    window.deleteFood = async function(id) {
      if (!confirm('Are you sure you want to delete this food item from Cloudflare D1?')) return;
      try {
        const res = await fetch('/api/admin', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'food', id })
        });
        const json = await res.json();
        if (json.success) {
          showToast('✓ Food item deleted from D1');
          loadFoods();
        }
      } catch (e) {
        alert('Delete failed: ' + e.message);
      }
    };

    const foodModal = document.getElementById('food-form-modal');
    document.getElementById('add-food-btn').addEventListener('click', () => {
      document.getElementById('food-form').reset();
      document.getElementById('food-id').value = '';
      document.getElementById('food-modal-title').textContent = 'Add New Food Item';
      foodModal.classList.remove('hidden');
      foodModal.classList.add('flex');
    });

    document.querySelectorAll('.close-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        foodModal.classList.add('hidden');
        foodModal.classList.remove('flex');
        document.getElementById('meal-form-modal').classList.add('hidden');
        document.getElementById('meal-form-modal').classList.remove('flex');
      });
    });

    window.editFood = function(id) {
      const food = allFoods.find(f => f.id === id);
      if (!food) return;
      document.getElementById('food-id').value = food.id;
      document.getElementById('food-name').value = food.name || '';
      document.getElementById('food-cal').value = food.cal !== undefined ? food.cal : '';
      document.getElementById('food-prot').value = food.prot !== undefined ? food.prot : '';
      document.getElementById('food-carb').value = food.carb !== undefined ? food.carb : '';
      document.getElementById('food-fat').value = food.fat !== undefined ? food.fat : '';
      document.getElementById('food-unit').value = food.unit || 'g';
      document.getElementById('food-country').value = food.country || 'IN';
      document.getElementById('food-modal-title').textContent = 'Edit Food Item';
      foodModal.classList.remove('hidden');
      foodModal.classList.add('flex');
    };

    document.getElementById('food-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const foodId = document.getElementById('food-id').value;
      const foodData = {
        name: document.getElementById('food-name').value.trim(),
        cal: parseFloat(document.getElementById('food-cal').value),
        prot: parseFloat(document.getElementById('food-prot').value),
        carb: parseFloat(document.getElementById('food-carb').value),
        fat: parseFloat(document.getElementById('food-fat').value),
        unit: document.getElementById('food-unit').value.trim() || 'g',
        country: document.getElementById('food-country').value.trim() || 'IN'
      };

      const isEdit = Boolean(foodId);
      const method = isEdit ? 'PUT' : 'POST';
      const bodyPayload = isEdit
        ? { type: 'food', id: parseInt(foodId), data: foodData }
        : { type: 'food', data: foodData };

      try {
        const res = await fetch('/api/admin', {
          method: method,
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(bodyPayload)
        });
        const json = await res.json();
        if (json.success) {
          foodModal.classList.add('hidden');
          foodModal.classList.remove('flex');
          showToast(isEdit ? '✓ Food item updated live in D1!' : '✓ New food item saved live to D1!');
          loadFoods();
        }
      } catch (e) {
        alert('Failed to save food: ' + e.message);
      }
    });

    // Meals Manager
    async function loadMeals() {
      try {
        const res = await fetch('/api/admin?type=meals', {
          headers: { 'Authorization': `Bearer ${adminToken}` }
        });
        const json = await res.json();
        if (json.success) {
          allMeals = json.data;
          document.getElementById('count-meals').textContent = allMeals.length;
          renderMeals(allMeals);
        }
      } catch (e) {
        console.error('Failed to load meals:', e);
      }
    }

    function renderMeals(meals) {
      const container = document.getElementById('meals-container');
      container.innerHTML = '';
      if (!meals.length) {
        container.innerHTML = '<div class="col-span-full p-6 text-center text-mute font-mono">No meal options found.</div>';
        return;
      }
      meals.forEach(m => {
        const card = document.createElement('div');
        card.className = 'bg-canvas border border-hairline rounded-xl p-4 space-y-2.5 shadow-vercel-sm hover:border-hairline-strong transition-all';
        card.innerHTML = `
          <div class="flex justify-between items-start">
            <span class="text-[10px] font-mono uppercase bg-primary/10 text-primary px-2 py-0.5 rounded font-semibold">${m.meal_slot}</span>
            <span class="text-[10px] font-mono text-mute bg-canvas-soft px-2 py-0.5 rounded border border-hairline">${m.country || 'IN'} | ${m.city || 'all'}</span>
          </div>
          <h4 class="font-sans font-semibold text-sm text-ink">${m.name}</h4>
          <div class="text-[11px] text-mute flex justify-between font-mono">
            <span>Diet: <strong class="text-body">${m.diet_type}</strong></span>
            <span>Profile: <strong class="text-body">${m.profile}</strong></span>
          </div>
          <div class="flex justify-between items-center border-t border-hairline pt-2 mt-2">
            <span class="text-[10px] font-mono text-mute">🕒 ${m.meal_time || '08:00 AM'}</span>
            <div>
              <button onclick="editMeal(${m.id})" class="px-2 py-1 bg-link/10 text-link hover:bg-link/20 rounded transition-colors text-[10px] font-mono mr-1">Edit</button>
              <button onclick="deleteMeal(${m.id})" class="px-2 py-1 bg-error/10 text-error hover:bg-error/20 rounded transition-colors text-[10px] font-mono">Delete</button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    document.getElementById('meal-country-filter').addEventListener('change', filterMeals);
    document.getElementById('meal-city-filter').addEventListener('change', filterMeals);
    document.getElementById('meal-diet-filter').addEventListener('change', filterMeals);

    function filterMeals() {
      const country = document.getElementById('meal-country-filter').value;
      const city = document.getElementById('meal-city-filter').value;
      const diet = document.getElementById('meal-diet-filter').value;

      const filtered = allMeals.filter(m => {
        const matchCountry = !country || m.country === country;
        const matchCity = !city || (m.city && (m.city === 'all' || m.city.includes(city)));
        const matchDiet = !diet || m.diet_type === diet;
        return matchCountry && matchCity && matchDiet;
      });
      renderMeals(filtered);
    }

    window.deleteMeal = async function(id) {
      if (!confirm('Are you sure you want to delete this meal option from D1?')) return;
      try {
        const res = await fetch('/api/admin', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'meal', id })
        });
        const json = await res.json();
        if (json.success) {
          showToast('✓ Meal option deleted from D1');
          loadMeals();
        }
      } catch (e) {
        alert('Delete failed: ' + e.message);
      }
    };

    const mealModal = document.getElementById('meal-form-modal');
    document.getElementById('add-meal-btn').addEventListener('click', () => {
      document.getElementById('meal-form').reset();
      document.getElementById('meal-id').value = '';
      document.getElementById('meal-modal-title').textContent = 'Add New City Meal Option';
      mealModal.classList.remove('hidden');
      mealModal.classList.add('flex');
    });

    window.editMeal = function(id) {
      const meal = allMeals.find(m => m.id === id);
      if (!meal) return;
      document.getElementById('meal-id').value = meal.id;
      document.getElementById('meal-name').value = meal.name || '';
      document.getElementById('meal-slot').value = meal.meal_slot || 'breakfast';
      document.getElementById('meal-time').value = meal.meal_time || '';
      document.getElementById('meal-diet').value = meal.diet_type || 'veg';
      document.getElementById('meal-profile').value = meal.profile || 'balanced';
      document.getElementById('meal-city').value = meal.city || 'all';
      document.getElementById('meal-modal-title').textContent = 'Edit City Meal Option';
      mealModal.classList.remove('hidden');
      mealModal.classList.add('flex');
    };

    document.getElementById('meal-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const mealId = document.getElementById('meal-id').value;
      const mealData = {
        name: document.getElementById('meal-name').value.trim(),
        meal_slot: document.getElementById('meal-slot').value,
        meal_time: document.getElementById('meal-time').value.trim() || '12:00 PM',
        diet_type: document.getElementById('meal-diet').value,
        profile: document.getElementById('meal-profile').value,
        country: document.getElementById('meal-country-filter').value || 'IN',
        city: document.getElementById('meal-city').value.trim() || 'all'
      };

      const isEdit = Boolean(mealId);
      const method = isEdit ? 'PUT' : 'POST';
      const bodyPayload = isEdit
        ? { type: 'meal', id: parseInt(mealId), data: mealData }
        : { type: 'meal', data: mealData };

      try {
        const res = await fetch('/api/admin', {
          method: method,
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(bodyPayload)
        });
        const json = await res.json();
        if (json.success) {
          mealModal.classList.add('hidden');
          mealModal.classList.remove('flex');
          showToast(isEdit ? '✓ Meal option updated live in D1!' : '✓ New meal option saved live to D1!');
          loadMeals();
        }
      } catch (e) {
        alert('Failed to save meal: ' + e.message);
      }
    });
  </script>
</Layout>
