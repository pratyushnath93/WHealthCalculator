---
// src/pages/admin.astro - Central Database Admin Panel for Cloudflare D1
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-canvas text-ink antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WHealth Admin — Central Food & Meal Database</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            canvas: '#090d16',
            'canvas-soft': '#121826',
            'canvas-card': '#1a2234',
            hairline: '#2a3449',
            primary: '#10b981',
            'primary-hover': '#059669',
            ink: '#f3f4f6',
            mute: '#9ca3af',
            danger: '#ef4444'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-canvas text-ink font-sans">

  <!-- Password Authentication Modal -->
  <div id="auth-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-canvas-card border border-hairline p-6 rounded-xl max-w-md w-full shadow-2xl space-y-4">
      <div class="text-center space-y-1">
        <div class="inline-flex p-3 rounded-full bg-primary/10 text-primary mb-2">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h2 class="text-xl font-bold tracking-tight">WHealth Admin Panel</h2>
        <p class="text-xs text-mute font-mono">Cloudflare D1 Central Database Manager</p>
      </div>

      <form id="auth-form" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-mute mb-1">Admin Password</label>
          <input type="password" id="admin-pass-input" placeholder="Enter admin password" required class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg text-sm focus:border-primary outline-none transition-colors">
        </div>
        <div id="auth-error" class="text-xs text-danger hidden">Incorrect password. Please try again.</div>
        <button type="submit" class="w-full py-2.5 bg-primary hover:bg-primary-hover text-white font-medium text-sm rounded-lg transition-colors shadow-lg">Authenticate & Access D1</button>
      </form>
    </div>
  </div>

  <!-- Main Admin Dashboard -->
  <div id="admin-app" class="hidden min-h-screen flex flex-col">
    <!-- Header -->
    <header class="border-b border-hairline bg-canvas-soft px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span class="text-2xl">⚡</span>
        <div>
          <h1 class="font-bold text-lg leading-tight">WHealth Database Admin</h1>
          <p class="text-xs text-mute font-mono">Connected to Cloudflare D1 SQL</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/health" class="text-xs text-mute hover:text-ink transition-colors font-mono">← Back to App</a>
        <button id="logout-btn" class="px-3 py-1.5 bg-hairline/50 hover:bg-hairline text-xs font-mono rounded-md transition-colors">Lock Panel</button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="border-b border-hairline bg-canvas-soft/50 px-6 flex gap-4 text-sm font-medium">
      <button id="tab-foods-btn" class="py-3 border-b-2 border-primary text-primary transition-colors">🍎 Food Directory (<span id="count-foods">0</span>)</button>
      <button id="tab-meals-btn" class="py-3 border-b-2 border-transparent text-mute hover:text-ink transition-colors">🥗 City Meals (<span id="count-meals">0</span>)</button>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 p-6 max-w-7xl w-full mx-auto space-y-6">

      <!-- FOODS TAB -->
      <section id="tab-foods" class="space-y-4">
        <div class="flex flex-wrap justify-between items-center gap-4">
          <div class="flex items-center gap-2 flex-1 max-w-md">
            <input type="text" id="food-search-input" placeholder="Search food by name..." class="w-full px-3 py-2 bg-canvas-card border border-hairline rounded-lg text-sm outline-none focus:border-primary">
            <select id="food-country-filter" class="px-3 py-2 bg-canvas-card border border-hairline rounded-lg text-sm outline-none focus:border-primary font-mono">
              <option value="">All Countries</option>
              <option value="IN">IN (India)</option>
              <option value="US">US</option>
              <option value="UK">UK</option>
              <option value="AE">AE (UAE)</option>
            </select>
          </div>
          <button id="add-food-btn" class="px-4 py-2 bg-primary hover:bg-primary-hover text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-1.5">
            <span>+ Add New Food</span>
          </button>
        </div>

        <!-- Foods Table -->
        <div class="border border-hairline rounded-xl bg-canvas-card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-canvas-soft font-mono uppercase text-mute border-b border-hairline">
                <tr>
                  <th class="p-3">ID</th>
                  <th class="p-3">Food Name</th>
                  <th class="p-3">Calories</th>
                  <th class="p-3">Prot (g)</th>
                  <th class="p-3">Carb (g)</th>
                  <th class="p-3">Fat (g)</th>
                  <th class="p-3">Unit</th>
                  <th class="p-3">Country</th>
                  <th class="p-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="foods-tbody" class="divide-y divide-hairline">
                <tr><td colspan="9" class="p-6 text-center text-mute font-mono">Loading foods from Cloudflare D1...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- MEALS TAB -->
      <section id="tab-meals" class="hidden space-y-4">
        <div class="flex flex-wrap justify-between items-center gap-4">
          <div class="flex items-center gap-2 flex-1 max-w-lg">
            <select id="meal-country-filter" class="px-3 py-2 bg-canvas-card border border-hairline rounded-lg text-sm outline-none focus:border-primary font-mono">
              <option value="IN">IN (India)</option>
              <option value="US">US</option>
              <option value="UK">UK</option>
              <option value="AE">AE</option>
            </select>
            <select id="meal-city-filter" class="px-3 py-2 bg-canvas-card border border-hairline rounded-lg text-sm outline-none focus:border-primary font-mono">
              <option value="">All Cities</option>
              <option value="kolkata">Kolkata</option>
              <option value="mumbai">Mumbai</option>
              <option value="bangalore">Bangalore</option>
              <option value="delhi">Delhi</option>
              <option value="chennai">Chennai</option>
            </select>
            <select id="meal-diet-filter" class="px-3 py-2 bg-canvas-card border border-hairline rounded-lg text-sm outline-none focus:border-primary font-mono">
              <option value="">All Diets</option>
              <option value="veg">Vegetarian</option>
              <option value="non-veg">Non-Vegetarian</option>
            </select>
          </div>
          <button id="add-meal-btn" class="px-4 py-2 bg-primary hover:bg-primary-hover text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-1.5">
            <span>+ Add New Meal</span>
          </button>
        </div>

        <div id="meals-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full p-6 text-center text-mute font-mono">Loading meals from D1...</div>
        </div>
      </section>

    </main>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 hidden bg-primary text-white px-4 py-2.5 rounded-lg shadow-xl text-xs font-mono font-medium transition-all z-50"></div>
  </div>

  <!-- Add/Edit Food Modal -->
  <div id="food-form-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-canvas-card border border-hairline p-6 rounded-xl max-w-lg w-full shadow-2xl space-y-4">
      <div class="flex justify-between items-center border-b border-hairline pb-3">
        <h3 id="food-modal-title" class="font-bold text-base">Add New Food Item</h3>
        <button class="close-modal-btn text-mute hover:text-ink">✕</button>
      </div>

      <form id="food-form" class="space-y-3 text-xs">
        <input type="hidden" id="food-id">
        <div>
          <label class="block text-mute mb-1">Food Name *</label>
          <input type="text" id="food-name" required placeholder="e.g. Masala Dosa" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary text-sm">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute mb-1">Calories (kcal) *</label>
            <input type="number" step="0.1" id="food-cal" required placeholder="150" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
          <div>
            <label class="block text-mute mb-1">Protein (g) *</label>
            <input type="number" step="0.1" id="food-prot" required placeholder="4.5" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute mb-1">Carbs (g) *</label>
            <input type="number" step="0.1" id="food-carb" required placeholder="25" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
          <div>
            <label class="block text-mute mb-1">Fat (g) *</label>
            <input type="number" step="0.1" id="food-fat" required placeholder="3.5" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute mb-1">Serving Unit</label>
            <input type="text" id="food-unit" placeholder="g / ml / pc / plate" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary">
          </div>
          <div>
            <label class="block text-mute mb-1">Country</label>
            <input type="text" id="food-country" value="IN" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary uppercase font-mono">
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t border-hairline pt-3 mt-4">
          <button type="button" class="close-modal-btn px-4 py-2 bg-hairline/50 hover:bg-hairline rounded-lg font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-hover text-white rounded-lg font-medium">Save to D1</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Meal Modal -->
  <div id="meal-form-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-canvas-card border border-hairline p-6 rounded-xl max-w-lg w-full shadow-2xl space-y-4">
      <div class="flex justify-between items-center border-b border-hairline pb-3">
        <h3 class="font-bold text-base">Add New City Meal Option</h3>
        <button class="close-modal-btn text-mute hover:text-ink">✕</button>
      </div>

      <form id="meal-form" class="space-y-3 text-xs">
        <div>
          <label class="block text-mute mb-1">Meal Title *</label>
          <input type="text" id="meal-name" required placeholder="e.g. Kolkata Fish Curry & Rice" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary text-sm">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-mute mb-1">Meal Slot *</label>
            <select id="meal-slot" required class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
              <option value="breakfast">Breakfast</option>
              <option value="snack1">Morning Snack</option>
              <option value="lunch">Lunch</option>
              <option value="snack2">Evening Snack</option>
              <option value="dinner">Dinner</option>
              <option value="bedtime">Bedtime Snack</option>
            </select>
          </div>
          <div>
            <label class="block text-mute mb-1">Default Time</label>
            <input type="text" id="meal-time" placeholder="08:30 AM" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-mute mb-1">Diet Type *</label>
            <select id="meal-diet" required class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary">
              <option value="veg">Vegetarian</option>
              <option value="non-veg">Non-Veg</option>
            </select>
          </div>
          <div>
            <label class="block text-mute mb-1">Goal Profile</label>
            <select id="meal-profile" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary">
              <option value="balanced">Balanced</option>
              <option value="high-protein">High Protein</option>
              <option value="surplus">Surplus</option>
            </select>
          </div>
          <div>
            <label class="block text-mute mb-1">City Tags</label>
            <input type="text" id="meal-city" placeholder="kolkata,mumbai,all" class="w-full px-3 py-2 bg-canvas border border-hairline rounded-lg outline-none focus:border-primary font-mono">
          </div>
        </div>

        <div class="flex justify-end gap-2 border-t border-hairline pt-3 mt-4">
          <button type="button" class="close-modal-btn px-4 py-2 bg-hairline/50 hover:bg-hairline rounded-lg font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-hover text-white rounded-lg font-medium">Save Meal to D1</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Admin JS Engine -->
  <script>
    let adminToken = '';
    let allFoods = [];
    let allMeals = [];

    // DOM Elements
    const authModal = document.getElementById('auth-modal');
    const authForm = document.getElementById('auth-form');
    const adminPassInput = document.getElementById('admin-pass-input');
    const authError = document.getElementById('auth-error');
    const adminApp = document.getElementById('admin-app');
    const logoutBtn = document.getElementById('logout-btn');
    const toast = document.getElementById('toast');

    // Tab switching
    const tabFoodsBtn = document.getElementById('tab-foods-btn');
    const tabMealsBtn = document.getElementById('tab-meals-btn');
    const tabFoods = document.getElementById('tab-foods');
    const tabMeals = document.getElementById('tab-meals');

    // Check stored session
    const savedToken = sessionStorage.getItem('whealth_admin_token');
    if (savedToken) {
      adminToken = savedToken;
      initDashboard();
    }

    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = adminPassInput.value.trim();
      if (!pass) return;

      // Verify token with API test request
      try {
        const res = await fetch('/api/admin?type=foods', {
          headers: { 'Authorization': `Bearer ${pass}` }
        });
        if (res.status === 401) {
          authError.classList.remove('hidden');
          return;
        }
        adminToken = pass;
        sessionStorage.setItem('whealth_admin_token', pass);
        authModal.classList.add('hidden');
        initDashboard();
      } catch (err) {
        authError.textContent = 'Connection error: ' + err.message;
        authError.classList.remove('hidden');
      }
    });

    logoutBtn.addEventListener('click', () => {
      sessionStorage.removeItem('whealth_admin_token');
      window.location.reload();
    });

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    function initDashboard() {
      authModal.classList.add('hidden');
      adminApp.classList.remove('hidden');
      loadFoods();
      loadMeals();
    }

    // Tabs logic
    tabFoodsBtn.addEventListener('click', () => {
      tabFoodsBtn.className = 'py-3 border-b-2 border-primary text-primary transition-colors';
      tabMealsBtn.className = 'py-3 border-b-2 border-transparent text-mute hover:text-ink transition-colors';
      tabFoods.classList.remove('hidden');
      tabMeals.classList.add('hidden');
    });

    tabMealsBtn.addEventListener('click', () => {
      tabMealsBtn.className = 'py-3 border-b-2 border-primary text-primary transition-colors';
      tabFoodsBtn.className = 'py-3 border-b-2 border-transparent text-mute hover:text-ink transition-colors';
      tabMeals.classList.remove('hidden');
      tabFoods.classList.add('hidden');
    });

    // ─── FOODS MANAGER ────────────────────────────────────────────────────────
    async function loadFoods() {
      try {
        const res = await fetch('/api/admin?type=foods', {
          headers: { 'Authorization': `Bearer ${adminToken}` }
        });
        const json = await res.json();
        if (json.success) {
          allFoods = json.data;
          document.getElementById('count-foods').textContent = allFoods.length;
          renderFoods(allFoods);
        }
      } catch (e) {
        console.error('Failed to load foods:', e);
      }
    }

    function renderFoods(foods) {
      const tbody = document.getElementById('foods-tbody');
      tbody.innerHTML = '';
      if (!foods.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="p-6 text-center text-mute font-mono">No food items found.</td></tr>';
        return;
      }
      foods.forEach(f => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-canvas-soft/60 transition-colors font-mono';
        tr.innerHTML = `
          <td class="p-3 text-mute">${f.id}</td>
          <td class="p-3 font-sans font-semibold text-ink">${f.name}</td>
          <td class="p-3 text-primary">${f.cal}</td>
          <td class="p-3">${f.prot}</td>
          <td class="p-3">${f.carb}</td>
          <td class="p-3">${f.fat}</td>
          <td class="p-3 text-mute">${f.unit || 'g'}</td>
          <td class="p-3"><span class="px-1.5 py-0.5 bg-hairline/60 rounded text-[10px]">${f.country || 'IN'}</span></td>
          <td class="p-3 text-right">
            <button onclick="deleteFood(${f.id})" class="text-danger hover:underline">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Search & Filter
    document.getElementById('food-search-input').addEventListener('input', filterFoods);
    document.getElementById('food-country-filter').addEventListener('change', filterFoods);

    function filterFoods() {
      const query = document.getElementById('food-search-input').value.toLowerCase();
      const country = document.getElementById('food-country-filter').value;
      const filtered = allFoods.filter(f => {
        const matchName = f.name.toLowerCase().includes(query);
        const matchCountry = !country || (f.country || 'IN') === country;
        return matchName && matchCountry;
      });
      renderFoods(filtered);
    }

    async function deleteFood(id) {
      if (!confirm('Are you sure you want to delete this food item from D1?')) return;
      try {
        const res = await fetch('/api/admin', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'food', id })
        });
        const json = await res.json();
        if (json.success) {
          showToast('Food item deleted successfully');
          loadFoods();
        }
      } catch (e) {
        alert('Delete failed: ' + e.message);
      }
    }

    // Modal controls
    const foodModal = document.getElementById('food-form-modal');
    document.getElementById('add-food-btn').addEventListener('click', () => {
      document.getElementById('food-form').reset();
      document.getElementById('food-id').value = '';
      document.getElementById('food-modal-title').textContent = 'Add New Food Item';
      foodModal.classList.remove('hidden');
      foodModal.classList.add('flex');
    });

    document.querySelectorAll('.close-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        foodModal.classList.add('hidden');
        foodModal.classList.remove('flex');
        document.getElementById('meal-form-modal').classList.add('hidden');
        document.getElementById('meal-form-modal').classList.remove('flex');
      });
    });

    document.getElementById('food-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const foodData = {
        name: document.getElementById('food-name').value.trim(),
        cal: parseFloat(document.getElementById('food-cal').value),
        prot: parseFloat(document.getElementById('food-prot').value),
        carb: parseFloat(document.getElementById('food-carb').value),
        fat: parseFloat(document.getElementById('food-fat').value),
        unit: document.getElementById('food-unit').value.trim() || 'g',
        country: document.getElementById('food-country').value.trim() || 'IN'
      };

      try {
        const res = await fetch('/api/admin', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'food', data: foodData })
        });
        const json = await res.json();
        if (json.success) {
          foodModal.classList.add('hidden');
          foodModal.classList.remove('flex');
          showToast('New food added to D1!');
          loadFoods();
        }
      } catch (e) {
        alert('Failed to save food: ' + e.message);
      }
    });

    // ─── MEALS MANAGER ────────────────────────────────────────────────────────
    async function loadMeals() {
      try {
        const res = await fetch('/api/admin?type=meals', {
          headers: { 'Authorization': `Bearer ${adminToken}` }
        });
        const json = await res.json();
        if (json.success) {
          allMeals = json.data;
          document.getElementById('count-meals').textContent = allMeals.length;
          renderMeals(allMeals);
        }
      } catch (e) {
        console.error('Failed to load meals:', e);
      }
    }

    function renderMeals(meals) {
      const container = document.getElementById('meals-container');
      container.innerHTML = '';
      if (!meals.length) {
        container.innerHTML = '<div class="col-span-full p-6 text-center text-mute font-mono">No meals found.</div>';
        return;
      }
      meals.forEach(m => {
        const card = document.createElement('div');
        card.className = 'bg-canvas-card border border-hairline rounded-xl p-4 space-y-2';
        card.innerHTML = `
          <div class="flex justify-between items-start">
            <span class="text-[10px] font-mono uppercase bg-primary/10 text-primary px-2 py-0.5 rounded font-semibold">${m.meal_slot}</span>
            <span class="text-[10px] font-mono text-mute">${m.country || 'IN'} | ${m.city || 'all'}</span>
          </div>
          <h4 class="font-bold text-sm text-ink">${m.name}</h4>
          <div class="text-[11px] text-mute flex justify-between font-mono">
            <span>Type: ${m.diet_type}</span>
            <span>Profile: ${m.profile}</span>
          </div>
          <div class="flex justify-between items-center border-t border-hairline pt-2 mt-2">
            <span class="text-[10px] font-mono text-mute">${m.meal_time || ''}</span>
            <button onclick="deleteMeal(${m.id})" class="text-xs text-danger hover:underline">Delete Meal</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Filter meals
    document.getElementById('meal-country-filter').addEventListener('change', filterMeals);
    document.getElementById('meal-city-filter').addEventListener('change', filterMeals);
    document.getElementById('meal-diet-filter').addEventListener('change', filterMeals);

    function filterMeals() {
      const country = document.getElementById('meal-country-filter').value;
      const city = document.getElementById('meal-city-filter').value;
      const diet = document.getElementById('meal-diet-filter').value;

      const filtered = allMeals.filter(m => {
        const matchCountry = !country || m.country === country;
        const matchCity = !city || (m.city && (m.city === 'all' || m.city.includes(city)));
        const matchDiet = !diet || m.diet_type === diet;
        return matchCountry && matchCity && matchDiet;
      });
      renderMeals(filtered);
    }

    async function deleteMeal(id) {
      if (!confirm('Are you sure you want to delete this meal and its ingredients from D1?')) return;
      try {
        const res = await fetch('/api/admin', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'meal', id })
        });
        const json = await res.json();
        if (json.success) {
          showToast('Meal deleted successfully');
          loadMeals();
        }
      } catch (e) {
        alert('Delete failed: ' + e.message);
      }
    }

    // Add Meal modal
    const mealModal = document.getElementById('meal-form-modal');
    document.getElementById('add-meal-btn').addEventListener('click', () => {
      document.getElementById('meal-form').reset();
      mealModal.classList.remove('hidden');
      mealModal.classList.add('flex');
    });

    document.getElementById('meal-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const mealData = {
        name: document.getElementById('meal-name').value.trim(),
        meal_slot: document.getElementById('meal-slot').value,
        meal_time: document.getElementById('meal-time').value.trim() || '12:00 PM',
        diet_type: document.getElementById('meal-diet').value,
        profile: document.getElementById('meal-profile').value,
        country: document.getElementById('meal-country-filter').value || 'IN',
        city: document.getElementById('meal-city').value.trim() || 'all'
      };

      try {
        const res = await fetch('/api/admin', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${adminToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'meal', data: mealData })
        });
        const json = await res.json();
        if (json.success) {
          mealModal.classList.add('hidden');
          mealModal.classList.remove('flex');
          showToast('New meal added to D1!');
          loadMeals();
        }
      } catch (e) {
        alert('Failed to save meal: ' + e.message);
      }
    });
  </script>
</body>
</html>
